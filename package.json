{
  "name": "js-table-merger",
  "version": "2.0.0",
  "description": "Merge and split cells of an HTML table, like the table tool in a word processor. No dependencies.",
  "keywords": [
    "table",
    "merge",
    "cells",
    "colspan",
    "rowspan",
    "dom"
  ],
  "author": "Tiago Câmara",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velovsky/js-table-merger.git"
  },
  "homepage": "https://velovsky.github.io/js-table-merger/",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/table-merger.js",
  "module": "./dist/table-merger.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/table-merger.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite --mode demo",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:demo": "vite build --mode demo",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
